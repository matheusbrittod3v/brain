{
  "name": "noema",
  "version": "0.1.0",
  "private": true,
  "description": "Noema (Project Brain OS 2.0) — Cérebro universal para engenharia de software, negócios e agentes de IA.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "dev:api": "bun --filter @noema/api dev",
    "dev:web": "bun --filter @noema/web dev",
    "start:api": "bun --filter @noema/api start",
    "start:local": "NOEMA_DEPLOYMENT_MODE=local bun --filter @noema/api start",
    "start:cloud": "NOEMA_DEPLOYMENT_MODE=cloud bun --filter @noema/api start",
    "start:web": "bun --filter @noema/web start",
    "start:worker": "bun --filter @noema/worker start",
    "db:bootstrap-roles": "bun --filter @noema/database db:bootstrap-roles",
    "db:migrate": "bun --filter @noema/database db:migrate",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "turbo": "^2.11.12"
  }
}
