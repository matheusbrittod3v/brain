# Banco Principal (PostgreSQL 16 + pgvector + pg-boss)
POSTGRES_ADMIN_PASSWORD=replace-with-admin-db-password
BRAIN_APP_DB_PASSWORD=replace-with-app-db-password
BRAIN_SYSTEM_DB_PASSWORD=replace-with-system-db-password
DATABASE_ADMIN_URL=postgresql://brain:replace-with-admin-db-password@localhost:5432/project_brain_os
DATABASE_SYSTEM_URL=postgresql://brain_system:replace-with-system-db-password@localhost:5432/project_brain_os
DATABASE_URL=postgresql://brain_app:replace-with-app-db-password@localhost:5432/project_brain_os

# Persistência PostgreSQL e fila pg-boss
BRAIN_PG_STORES=1
BRAIN_PG_BOSS=1

# API, URLs Base & Auth Bootstrap
PORT=3333
BRAIN_CORS_ORIGIN=http://localhost:3000
BRAIN_LOCAL_API_KEY=replace-with-unique-local-secret
BRAIN_JWT_SECRET=replace-with-unique-jwt-secret-min-32-chars
BRAIN_REGISTRATION_ENABLED=true
BRAIN_REQUIRE_EMAIL_VERIFICATION=false
OPA_URL=http://localhost:8181

# Nota: Embeddings (Ollama/OpenAI), Modelos do Runner, SMTP, GitHub e Políticas Padrão
# são armazenados dinamicamente no PostgreSQL (tabela `system_settings`)
# e editáveis via Web UI (Perfil -> Configurações (DB)), REST (/v1/system/settings) ou MCP.

NUXT_TELEMETRY_DISABLED=1
