# Banco Principal (PostgreSQL 16 + pgvector + pg-boss)
# Exemplos somente para desenvolvimento local. Use segredos fora do repositório em produção.
POSTGRES_ADMIN_PASSWORD=change-me-local-admin
BRAIN_APP_DB_PASSWORD=change-me-local-app
BRAIN_SYSTEM_DB_PASSWORD=change-me-local-system
DATABASE_ADMIN_URL=postgresql://brain_admin:change-me-local-admin@localhost:5432/project_brain_os
DATABASE_SYSTEM_URL=postgresql://brain_system:change-me-local-system@localhost:5432/project_brain_os
DATABASE_URL=postgresql://brain_app:change-me-local-app@localhost:5432/project_brain_os

# Persistência PostgreSQL e fila pg-boss (1 = ativo, 0/ausente = fallback em memória)
BRAIN_PG_STORES=1
BRAIN_PG_BOSS=1

# API & Auth Local
PORT=3333
# Gere um segredo exclusivo antes de iniciar a API; valores de exemplo são rejeitados.
BRAIN_LOCAL_API_KEY=
BRAIN_CORS_ORIGIN=http://localhost:3000

# Gere um segredo aleatório de pelo menos 32 caracteres para assinar sessões.
BRAIN_JWT_SECRET=
# Defina as credenciais do administrador inicial; sem elas, não existe senha administrativa padrão.
BRAIN_ADMIN_EMAIL=
BRAIN_ADMIN_PASSWORD=
# Autenticação e cadastro
BRAIN_REGISTRATION_ENABLED=true
BRAIN_REQUIRE_EMAIL_VERIFICATION=false

# Configurações SMTP de Email (se vazias, simula envio seguro em dev/testes)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@brain.local
SMTP_SECURE=false

# OIDC público para apps/web (Authorization Code + PKCE); deixe vazio no modo local com chave explícita.
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8080/realms/brain
NEXT_PUBLIC_OIDC_CLIENT_ID=brain-web
# API valida JWT do mesmo realm via JWKS/audience.
OIDC_ISSUER=http://localhost:8080/realms/brain
OIDC_JWKS_URI=http://localhost:8080/realms/brain/protocol/openid-connect/certs
OIDC_AUDIENCE=brain-web
# Escopos confiáveis do servidor local, separados por vírgula; sem wildcard.
BRAIN_ALLOWED_PROJECTS=local-project
BRAIN_ALLOWED_POLICIES=public-org,internal-project
# Política explícita para eventos de auditoria emitidos pelas tools MCP.
BRAIN_AUDIT_POLICY_ID=internal-project
# Workspace padrão do servidor MCP para brain_validate_implementation.
# Raiz por projeto (JSON) tem precedência e deve conter somente caminhos absolutos administrados pelo servidor.
BRAIN_WORKSPACE_ROOT=/absolute/path/to/workspace
BRAIN_PROJECT_WORKSPACE_ROOTS={"local-project":"/absolute/path/to/workspace"}
# Segredo HMAC para webhooks/eventos Git e CI/CD
BRAIN_CHANNEL_WEBHOOK_SECRET=change-me-local-channel-secret
BRAIN_EXTERNAL_ACTOR_MAP_JSON='{}'

# Ingestão remota Git / GitHub (PAT opcional; ou GitHub App para repositórios privados)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Webhooks push GitHub: HMAC no corpo bruto + escopo confiável por repositório.
GITHUB_WEBHOOK_SECRET=
BRAIN_GITHUB_REPO_MAP_JSON='{"acme/billing":{"tenantId":"default-org","projectId":"billing","accessPolicyId":"internal-project"}}'

# IA Local Opcional (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# Runner usa modelo apenas com opt-in explícito; as respostas Ollama registram contagem de tokens.
# BRAIN_RUNNER_MODEL_EXECUTION=ollama
BRAIN_RUNNER_DAILY_TOKEN_LIMIT=100000
# RUNNER_MODEL=qwen2.5-coder:3b

