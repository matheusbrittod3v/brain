{
  "name": "brain",
  "version": "0.1.0",
  "private": true,
  "description": "Brain (Project Brain OS 2.0) — Cérebro universal para engenharia de software, negócios e agentes de IA.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "init": "bun scripts/init.ts",
    "init:start": "bun scripts/init.ts --start",
    "init:infra": "bun scripts/init.ts --infra",
    "init:doctor": "bun scripts/init.ts --check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "dev:api": "bun --filter @brain/api dev",
    "dev:web": "bun --filter @brain/web dev",
    "start:api": "bun --filter @brain/api start",
    "start:local": "BRAIN_DEPLOYMENT_MODE=local bun --filter @brain/api start",
    "start:cloud": "BRAIN_DEPLOYMENT_MODE=cloud bun --filter @brain/api start",
    "start:web": "bun --filter @brain/web start",
    "start:worker": "bun --filter @brain/worker start",
    "db:bootstrap-roles": "bun --filter @brain/database db:bootstrap-roles",
    "db:migrate": "bun --filter @brain/database db:migrate",
    "infra:up": "docker-compose -f infra/docker/docker-compose.yml up -d || docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker-compose -f infra/docker/docker-compose.yml down || docker compose -f infra/docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "turbo": "^2.11.12"
  }
}
