{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brain.dev/protocols/runner-tasks/schema.json",
  "title": "RunnerTask",
  "type": "object",
  "required": ["taskId", "tenantId", "projectId", "instruction", "draftOnly", "maxSteps", "timeoutSeconds"],
  "properties": {
    "taskId": { "type": "string" },
    "tenantId": { "type": "string" },
    "projectId": { "type": "string" },
    "instruction": { "type": "string" },
    "priority": { "type": "string", "enum": ["low", "normal", "high"], "default": "normal" },
    "cron": { "type": "string", "description": "Expressão cron UTC para criar uma recorrência; cada ocorrência gera um RunnerTask independente com taskId próprio." },
    "draftOnly": { "type": "boolean", "const": true },
    "maxSteps": { "type": "integer", "minimum": 1, "maximum": 30 },
    "timeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 600 },
    "escalateOnFailure": { "type": "boolean", "default": true }
  }
}

